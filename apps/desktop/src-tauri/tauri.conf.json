{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltFlip",
  "mainBinaryName": "AltFlip",
  "version": "0.1.0",
  "identifier": "io.coreify.altflip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AltFlip",
        "width": 1100,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "title": "AltFlip",
        "url": "index.html?surface=quick",
        "width": 420,
        "height": 580,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Switch between AI coding accounts",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
